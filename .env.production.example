# Salin isi berkas ini ke tab Environment di Dokploy, lalu ganti semua nilai GANTI_*.
# Panduan lengkap: bagian "Deploy ke VPS dengan Dokploy" di README.md.

APP_NAME="Kebun Kita POS"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# base64:... buat dengan perintah di README
APP_KEY=GANTI_APP_KEY
APP_URL=https://GANTI_DOMAIN

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
BCRYPT_ROUNDS=12

# Tampil di log container Dokploy
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=kebunkita-db
DB_PORT=5432
DB_DATABASE=kebun_kita
DB_USERNAME=kebunkita
DB_PASSWORD=GANTI_PASSWORD_DATABASE
DB_SCHEMA=kebun_kita

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# Tanpa https:// dan tanpa garis miring
SANCTUM_STATEFUL_DOMAINS=GANTI_DOMAIN

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=GANTI_ANGKA_ACAK
REVERB_APP_KEY=GANTI_KUNCI_ACAK
REVERB_APP_SECRET=GANTI_RAHASIA_ACAK
# Aplikasi mengirim siaran ke Reverb lewat jaringan internal Docker
REVERB_HOST=kebunkita-reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Kosong: browser memakai domain dan port yang sama dengan aplikasi
REVERB_CLIENT_PORT=
# Hanya domain ini yang boleh membuka WebSocket
REVERB_ALLOWED_ORIGINS=GANTI_DOMAIN

# Hanya dipakai satu kali saat menjalankan php artisan db:seed --force
SEED_DATA_DEMO=false
SEED_PASSWORD_PEMILIK=GANTI_PASSWORD_PEMILIK
SEED_PASSWORD_STAF=GANTI_PASSWORD_STAF
